{
  "adapter": "cddl",
  "canonical": {
    "channels": [],
    "description": "COSE-shaped grammar: the tagged signature and encryption structures, the header maps with their negative-integer labels, and the key structure. Reconstructed from the shape of the COSE structures; no upstream text copied.",
    "extras": {
      "cddl": {
        "capability_limits": [
          {
            "construct": "cddl.control_cbor",
            "count": 1,
            "detail": "`.cbor` and `.cborseq` say a byte string carries a *nested* CBOR encoding of another type. The canonical model has no embedded-encoding facet, so the member stays a byte string and the embedded type is recorded in `cddl_control` — the nesting is described, not modelled.",
            "locations": [
              "empty_or_serialized_map-branch1"
            ]
          },
          {
            "construct": "cddl.open_map_entry",
            "count": 2,
            "detail": "A table entry (`* label => values`) alongside named members admits any number of further entries whose keys are not enumerable. The named members are carried and the table becomes one open-content member named `*`; a map whose *whole* body is a table is modelled exactly, as a canonical `MAP`.",
            "locations": [
              "COSE_Key",
              "header_map"
            ]
          },
          {
            "construct": "cddl.tag",
            "count": 5,
            "detail": "A CBOR tag (`#6.1(number)`) marks a value's semantics in the encoding. The canonical model has no tag facet, so the tagged type is carried and the tag number is recorded in `cddl_tag` — preserved and re-emitted, but not modelled.",
            "locations": [
              "COSE_Encrypt0_Tagged",
              "COSE_Encrypt_Tagged",
              "COSE_Mac0_Tagged",
              "COSE_Sign1_Tagged",
              "COSE_Sign_Tagged"
            ]
          }
        ],
        "group_rules": [
          "Headers",
          "Generic_Headers"
        ],
        "members": [
          "cddl/05-real-world-cose-shaped.cddl"
        ],
        "root_rule": "COSE_Messages",
        "root_type": "COSE_Messages"
      }
    },

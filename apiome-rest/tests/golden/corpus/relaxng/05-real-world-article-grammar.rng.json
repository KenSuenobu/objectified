{
  "adapter": "relaxng",
  "canonical": {
    "channels": [],
    "description": "Publishing article grammar in the shape DocBook- and TEI-derived house schemas take: a metadata header, recursive sections, mixed-content prose, and a figure model.",
    "extras": {
      "relaxng": {
        "capability_limits": [
          {
            "construct": "relaxng.interleave",
            "count": 1,
            "detail": "`interleave` admits its branches in any order. Neither the canonical model nor JSON Schema has an unordered-any-order construct, so the branches are kept as ordinary members and their order-independence is not expressible.",
            "locations": [
              "info"
            ]
          },
          {
            "construct": "relaxng.mixed",
            "count": 1,
            "detail": "`mixed` interleaves text with element content. The canonical model has no mixed-content record, so the text half is carried as an open-content member alongside the element members.",
            "locations": [
              "inline"
            ]
          }
        ],

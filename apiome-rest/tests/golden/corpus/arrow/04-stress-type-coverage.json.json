{
  "adapter": "arrow",
  "canonical": {
    "channels": [],
    "description": null,
    "extras": {
      "arrow": {
        "capability_limits": [
          {
            "construct": "arrow.decimal_width",
            "count": 2,
            "detail": "A `decimal` declares a precision, a scale and a storage width (128 or 256 bits). The canonical constraint vocabulary has no precision/scale facet, so the field keeps the `decimal` scalar and all three are recorded in `arrow_decimal` — preserved and reportable, but not enforced.",
            "locations": [
              "f_decimal128",
              "f_decimal256"
            ]
          },
          {
            "construct": "arrow.dictionary_encoding",
            "count": 2,
            "detail": "A dictionary-encoded field stores integer indices into a dictionary of its declared value type. The *values* are what the schema describes, so the field keeps its value type; the index type and whether the dictionary is ordered are recorded in `arrow_dictionary`. The dictionary's numeric id is not carried — it names a message in an IPC stream, not a property of the data.",
            "locations": [
              "f_dictionary",
              "f_ordered_dictionary"
            ]
          },
          {
            "construct": "arrow.extension_type",
            "count": 1,
            "detail": "An `ARROW:extension:name` field names a logical type layered over a storage type (`arrow.uuid` over `fixed_size_binary[16]`). The canonical model has no extension registry, so the storage type is carried and the extension name and its opaque parameters are recorded in `arrow_extension`.",
            "locations": [
              "f_extension"
            ]
          },
          {
            "construct": "arrow.half_precision",
            "count": 1,
            "detail": "A `floatingpoint` of `HALF` precision is a 16-bit float. The canonical scalar vocabulary starts at 32 bits, so the field carries `float` — a strictly wider value space than the column holds — and the declared precision is recorded in `arrow_type`.",
            "locations": [
              "f_half"
            ]
          },
          {
            "construct": "arrow.interval",
            "count": 2,
            "detail": "An `interval` is a calendar offset (`YEAR_MONTH`, `DAY_TIME`, `MONTH_DAY_NANO`) whose components are not reducible to a fixed amount of time. The canonical model has no calendar-offset scalar, so the field is carried as a `duration`-formatted string and the unit is recorded in `arrow_type` — the nearest analogue, not an equivalent.",
            "locations": [
              "f_interval_mdn",
              "f_interval_ym"
            ]
          },
          {
            "construct": "arrow.physical_layout",
            "count": 2,
            "detail": "The large-offset (`largeutf8`, `largelist`, `largebinary`), view (`utf8view`, `binaryview`, `listview`) and run-end-encoded variants hold exactly the value space of their ordinary counterparts and differ only in memory layout. The canonical type is that counterpart and the declared variant is recorded in `arrow_type`, so nothing about the data is lost and nothing about the layout is claimed.",
            "locations": [
              "f_large_list",
              "f_large_utf8"
            ]
          },
          {
            "construct": "arrow.temporal_unit",
            "count": 7,
            "detail": "A `date`, `time`, `timestamp` or `duration` declares a resolution (`DAY`, `SECOND`, `MILLISECOND`, `MICROSECOND`, `NANOSECOND`) and a `timestamp` may declare a timezone. The canonical model has a semantic format hint and no resolution facet, so the field carries `date`/`time`/`date-time`/`duration` and the unit and timezone are recorded in `arrow_type`.",
            "locations": [
              "f_date_day",
              "f_date_ms",
              "f_duration",
              "f_time_ns",
              "f_time_s",
              "f_timestamp_naive",
              "f_timestamp_tz"
            ]
          },
          {
            "construct": "arrow.union_layout",
            "count": 2,
            "detail": "A `union` declares a mode (`DENSE` or `SPARSE`) and the type code each variant is stored under. The variants themselves become a canonical `UNION`; the mode and the type codes are storage, and are recorded in `arrow_union` rather than modelled.",
            "locations": [
              "f_dense_union",
              "f_sparse_union"
            ]
          }
        ],
        "root": "Schema",
        "schema_metadata": {
          "arrow_format_version": "1.4",
          "purpose": "type coverage"
        }
      }
    },

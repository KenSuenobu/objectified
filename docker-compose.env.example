# Copy to `.env` in the repo root (same directory as docker-compose.yml) to override defaults.

# Postgres (must match across postgres / migrate / mcp)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=apiome_local_dev
# POSTGRES_DB=apiome

# Host port mapping (optional)
# POSTGRES_PUBLISH_PORT=5432

# REST HTTP port on the host (apiome-rest always listens on 8000 in-container)
# APIOME_REST_HTTP_PORT=8000

# MCP HTTP port on the host (must match in-container APIOME_MCP_HTTP_PORT)
# APIOME_MCP_HTTP_PORT=8765

# Mock HTTP port on the host (apiome-mock always listens on 8775 in-container)
# APIOME_MOCK_HTTP_PORT=8775
# Public mock base URL returned in version GET responses (REST control plane)
# APIOME_MOCK_PUBLIC_BASE_URL=http://localhost:8775

# Required by apiome-mcp at runtime (min 16 characters); compose supplies a dev default
# APIOME_MCP_INTERNAL_SECRET=replace-with-at-least-16-chars

# apiome-rest auth/CORS hardening (see docs/security/AUTH_MODEL.md).
# The Postgres credentials above are DEV-ONLY defaults — override them for any non-local use.
# In production set APIOME_ENV=production AND a strong shared JWT secret, or REST refuses
# to start (it will not fall back to the insecure built-in default).
# APIOME_ENV=development
# BETTER_AUTH_SECRET=replace-with-output-of: openssl rand -base64 32
# APIOME_CORS_ALLOWED_ORIGINS=https://app.example.com

# Bundled-toolchain enforcement (FMT-1.3). The image ships @asyncapi/parser, which the AsyncAPI
# import adapter hard-requires (there is no fallback parser). Left at the image default (1),
# apiome-rest logs the parser version it resolved at startup and REFUSES to start if it cannot
# run it, rather than coming up with AsyncAPI import silently missing. Set to 0 only for a
# deliberately slimmed deployment that accepts losing AsyncAPI import; it then starts, logs the
# loss as an ERROR, and reports it in the `toolchain` block of GET /health.
# APIOME_REQUIRE_TOOLCHAIN=1

# Super-admin session, shared by apiome-ui and apiome-rest (OLO-8.4). The /admin settings
# screen calls `GET /api/admin/auth-providers` on apiome-ui, which forwards the signed
# `admin_session` token to apiome-rest, where it is verified AGAIN against apiome-rest's own
# copy of the key. Both resolve it the same way: ADMIN_SESSION_SECRET wins, else it is derived
# from ADMIN_PASSWORD. docker-compose.yml passes both variables from this file into the
# apiome-rest container, so setting them here keeps the two sides in sync.
#
# Leave both unset and apiome-rest fails closed: the settings screen 403s on every load
# (`GET /api/admin/auth-providers 403`) and reports an invalid/expired super-admin session
# immediately after a successful login. Setting them to values that DIFFER between the two
# services produces the same 403.
# ADMIN_PASSWORD=your_secure_admin_password_here
# ADMIN_SESSION_SECRET=replace-with-output-of: openssl rand -base64 48

# DB-over-env sign-in provider configuration, the rest of the set (OLO-8.3/8.5). Also passed
# through to apiome-rest by docker-compose.yml, and each must match apiome-ui byte for byte.
# AUTH_CONFIG_ENC_KEY seals client secrets saved from the admin screen — unset ⇒ saving a
# secret returns 503. INTERNAL_SERVICE_TOKEN gates the login-time resolved-config read —
# unset ⇒ 503 ⇒ sign-in silently keeps using the *_ID/*_SECRET env vars instead.
# AUTH_CONFIG_ENC_KEY=replace-with-output-of: openssl rand -base64 32
# INTERNAL_SERVICE_TOKEN=replace-with-output-of: openssl rand -base64 48

# apiome-rest MCP credential encryption-at-rest (MCAT-6.2, #3678). REQUIRED before a
# protected (authenticated) MCP server's credential can be stored — otherwise the API returns
# "MCP credential encryption is not configured; set APIOME_MCP_CREDENTIAL_ENCRYPTION_KEYS
# before storing a secret". JSON mapping an integer key-version to a base64 32-byte AES-256 key.
# Generate: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Quote JSON if this file is also sourced by a shell; Compose accepts either form:
# APIOME_MCP_CREDENTIAL_ENCRYPTION_KEYS={"1": "<base64 32-byte key>"}
# APIOME_MCP_CREDENTIAL_ENCRYPTION_KEYS='{"1": "<base64 32-byte key>"}'

# Optional apiome-mcp overrides (defaults documented in apiome-mcp/docs/CONFIGURATION.md)
# APIOME_MCP_LOG_LEVEL=INFO
# APIOME_MCP_DATABASE_POOL_MIN_SIZE=1
# APIOME_MCP_DATABASE_POOL_MAX_SIZE=10
# APIOME_MCP_DATABASE_POOL_TIMEOUT=30
# APIOME_MCP_OPENAPI_MAX_JSON_BYTES=2097152

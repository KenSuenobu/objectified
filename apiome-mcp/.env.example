# apiome-mcp environment (prefix APIOME_MCP_)
# Copy to ".env" in your working directory. Schema matches apiome_mcp.settings.Settings.

# -----------------------------------------------------------------------------
# Required (no defaults — process fails fast at startup if missing or invalid)
# -----------------------------------------------------------------------------
# PostgreSQL connection URI for the Apiome database.
APIOME_MCP_DATABASE_URL=postgresql://user:password@localhost:5432/apiome
# Secret for internal signing (HMAC, etc.). Minimum 16 characters.
APIOME_MCP_INTERNAL_SECRET=replace-with-at-least-16-chars

# -----------------------------------------------------------------------------
# Optional — defaults shown below match Settings in settings.py
# -----------------------------------------------------------------------------
# Root log level (DEBUG | INFO | WARNING | ERROR | CRITICAL).
# APIOME_MCP_LOG_LEVEL=INFO

# Default transport in settings: stdio | http. The CLI still needs an explicit
#   uv run apiome-mcp serve --transport stdio
#   uv run apiome-mcp serve --transport http
# when you want to run the server (omit both to validate env only).
# APIOME_MCP_TRANSPORT=stdio

# HTTP bind address and port when using --transport http (or Docker CMD).
# APIOME_MCP_HTTP_HOST=127.0.0.1
# APIOME_MCP_HTTP_PORT=8765

# Async connection pool (psycopg_pool). Max must be >= min.
# APIOME_MCP_DATABASE_POOL_MIN_SIZE=1
# APIOME_MCP_DATABASE_POOL_MAX_SIZE=10
# Seconds to wait for a connection from the pool.
# APIOME_MCP_DATABASE_POOL_TIMEOUT=30

# Max UTF-8 size for OpenAPI JSON/YAML exports (413-style limit).
# APIOME_MCP_OPENAPI_MAX_JSON_BYTES=2097152

# spec.search_semantic (OpenAI-compatible embeddings). Dimension must match DB column (default 1536).
# APIOME_MCP_OPENAI_API_KEY=
# APIOME_MCP_OPENAI_EMBEDDING_URL=https://api.openai.com/v1/embeddings
# APIOME_MCP_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# APIOME_MCP_OPENAI_EMBEDDING_DIMENSIONS=1536
# APIOME_MCP_OPENAI_EMBEDDING_TIMEOUT_S=60

# Host tenant UUID for anonymous tools/call gating (MTG-2.3). When unset, anonymous
# callers are not gated (legacy passthrough). When set, that tenant's
# allow_anonymous_mcp + anonymous enable-set apply; authenticated keys are unaffected.
# APIOME_MCP_ANONYMOUS_POLICY_TENANT_ID=

# Public root of the hosted SIM mock runtime (AGX-2.4). Toolsets with target=mock send
# tools/call to {root}/{tenant}/{project}/{version} instead of the production upstream,
# so an agent can practise with no upstream credentials configured. Mirrors apiome-rest's
# APIOME_MOCK_PUBLIC_BASE_URL; must be absolute http(s). See docs/MOCK_TARGET.md.
# APIOME_MCP_MOCK_PUBLIC_BASE_URL=http://localhost:8775

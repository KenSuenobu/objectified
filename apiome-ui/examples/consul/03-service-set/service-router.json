{
  "Kind": "service-router",
  "Name": "orders",
  "Routes": [
    {
      "Match": { "HTTP": { "PathPrefix": "/v2/orders", "Methods": ["GET", "POST"] } },
      "Destination": { "Service": "orders", "RequestTimeout": "15s" }
    },
    {
      "Match": { "HTTP": { "PathPrefix": "/v2/products" } },
      "Destination": { "Service": "catalogue", "PrefixRewrite": "/products" }
    }
  ]
}

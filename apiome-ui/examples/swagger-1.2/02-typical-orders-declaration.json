{
  "swaggerVersion": "1.2",
  "apiVersion": "2.3.0",
  "basePath": "https://api.example.com/v2",
  "resourcePath": "/orders",
  "produces": ["application/json"],
  "consumes": ["application/json"],
  "apis": [
    {
      "path": "/orders",
      "operations": [
        {
          "method": "GET",
          "nickname": "listOrders",
          "summary": "List orders",
          "notes": "Returns the caller's orders, newest first.",
          "type": "array",
          "items": { "$ref": "Order" },
          "parameters": [
            {
              "name": "status",
              "paramType": "query",
              "description": "Filter by lifecycle status.",
              "required": false,
              "type": "string",
              "enum": ["new", "paid", "shipped", "cancelled"]
            },
            {
              "name": "limit",
              "paramType": "query",
              "required": false,
              "type": "integer",
              "format": "int32",
              "defaultValue": "25",
              "minimum": "1",
              "maximum": "100"
            }
          ],
          "responseMessages": [
            { "code": 200, "message": "Matching orders" },
            { "code": 401, "message": "Not authenticated" }
          ]
        },
        {
          "method": "POST",
          "nickname": "placeOrder",
          "summary": "Place an order",
          "type": "Order",
          "consumes": ["application/json"],
          "parameters": [
            {
              "name": "body",
              "paramType": "body",
              "required": true,
              "type": "NewOrder"
            }
          ],
          "responseMessages": [
            { "code": 201, "message": "Order created", "responseModel": "Order" },
            { "code": 422, "message": "Invalid order", "responseModel": "ErrorModel" }
          ]
        }
      ]
    },
    {
      "path": "/orders/{orderId}",
      "operations": [
        {
          "method": "GET",
          "nickname": "getOrder",
          "summary": "Fetch one order",
          "type": "Order",
          "parameters": [
            {
              "name": "orderId",
              "paramType": "path",
              "required": true,
              "type": "string"
            }
          ],
          "responseMessages": [
            { "code": 404, "message": "No such order", "responseModel": "ErrorModel" }
          ]
        },
        {
          "method": "DELETE",
          "nickname": "cancelOrder",
          "summary": "Cancel an order",
          "type": "void",
          "parameters": [
            { "name": "orderId", "paramType": "path", "required": true, "type": "string" },
            { "name": "reason", "paramType": "query", "required": false, "type": "string" }
          ],
          "responseMessages": [{ "code": 204, "message": "Cancelled" }]
        }
      ]
    }
  ],
  "models": {
    "Order": {
      "id": "Order",
      "description": "A placed order.",
      "required": ["orderId", "status", "lines"],
      "properties": {
        "orderId": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "paid", "shipped", "cancelled"] },
        "placedAt": { "type": "string", "format": "date-time" },
        "total": { "type": "number", "format": "double" },
        "lines": { "type": "array", "items": { "$ref": "OrderLine" } }
      }
    },
    "NewOrder": {
      "id": "NewOrder",
      "required": ["lines"],
      "properties": {
        "lines": { "type": "array", "items": { "$ref": "OrderLine" } },
        "note": { "type": "string" }
      }
    },
    "OrderLine": {
      "id": "OrderLine",
      "required": ["sku", "quantity"],
      "properties": {
        "sku": { "type": "string" },
        "quantity": { "type": "integer", "format": "int32", "minimum": "1" },
        "unitPrice": { "type": "number", "format": "double" }
      }
    },
    "ErrorModel": {
      "id": "ErrorModel",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer", "format": "int32" },
        "message": { "type": "string" }
      }
    }
  }
}

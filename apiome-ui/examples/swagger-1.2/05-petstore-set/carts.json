{
  "swaggerVersion": "1.2",
  "apiVersion": "1.0.0",
  "basePath": "https://api.example.com/store",
  "resourcePath": "/carts",
  "produces": ["application/json"],
  "consumes": ["application/json"],
  "apis": [
    {
      "path": "/carts",
      "operations": [
        {
          "method": "POST",
          "nickname": "createCart",
          "summary": "Open a cart",
          "type": "Cart",
          "responseMessages": [{ "code": 201, "message": "Cart created", "responseModel": "Cart" }]
        }
      ]
    },
    {
      "path": "/carts/{cartId}/items",
      "operations": [
        {
          "method": "POST",
          "nickname": "addCartItem",
          "summary": "Add an item to a cart",
          "type": "Cart",
          "parameters": [
            { "name": "cartId", "paramType": "path", "required": true, "type": "string" },
            { "name": "body", "paramType": "body", "required": true, "type": "CartItem" }
          ]
        }
      ]
    }
  ],
  "models": {
    "Cart": {
      "id": "Cart",
      "required": ["cartId"],
      "properties": {
        "cartId": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "CartItem" } },
        "total": { "type": "number", "format": "double" }
      }
    },
    "CartItem": {
      "id": "CartItem",
      "required": ["sku", "quantity"],
      "properties": {
        "sku": { "type": "string" },
        "quantity": { "type": "integer", "format": "int32", "minimum": "1" }
      }
    }
  }
}

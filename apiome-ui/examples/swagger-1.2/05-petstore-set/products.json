{
  "swaggerVersion": "1.2",
  "apiVersion": "1.0.0",
  "basePath": "https://api.example.com/store",
  "resourcePath": "/products",
  "produces": ["application/json"],
  "apis": [
    {
      "path": "/products",
      "operations": [
        {
          "method": "GET",
          "nickname": "listProducts",
          "summary": "List products",
          "type": "array",
          "items": { "$ref": "Product" },
          "parameters": [
            { "name": "category", "paramType": "query", "required": false, "type": "string" }
          ]
        }
      ]
    },
    {
      "path": "/products/{sku}",
      "operations": [
        {
          "method": "GET",
          "nickname": "getProduct",
          "summary": "Fetch a product",
          "type": "Product",
          "parameters": [{ "name": "sku", "paramType": "path", "required": true, "type": "string" }],
          "responseMessages": [{ "code": 404, "message": "No such product" }]
        }
      ]
    }
  ],
  "models": {
    "Product": {
      "id": "Product",
      "required": ["sku", "name", "price"],
      "properties": {
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number", "format": "double" },
        "category": { "type": "string" }
      }
    }
  }
}

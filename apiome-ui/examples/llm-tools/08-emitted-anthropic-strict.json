    "input_schema": {
      "type": "object",
      "properties": {
        "redirect_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "X-Client-Version": {
          "type": [
            "string",
            "null"
          ]
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string",
          "format": "password"
        }
      },
      "required": [
        "redirect_uri",
        "X-Client-Version",
        "username",
        "password"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "listItems",
    "description": "List items",
    "input_schema": {
      "type": "object",
      "properties": {
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1.0
        },
        "per_page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1.0,
          "maximum": 100.0
        },
        "q": {
          "type": [
            "string",
            "null"
          ]
        },
        "sort": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "name",
            "createdAt",
            "-name",
            "-createdAt"
          ]
        },
        "X-Tenant-ID": {
          "type": "string",
          "format": "uuid",
          "description": "Tenant identifier"
        }
      },
      "required": [
        "page",
        "per_page",
        "q",
        "sort",
        "X-Tenant-ID"
      ],
      "additionalProperties": false
    }
  }
]

            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "username",
          "password"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "listItems",
      "description": "List items",
      "parameters": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "default": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1.0,
            "maximum": 100.0,
            "default": 20
          },
          "q": {
            "type": "string"
          },
          "sort": {
            "type": "string",
            "enum": [
              "name",
              "createdAt",
              "-name",
              "-createdAt"
            ]
          },
          "X-Tenant-ID": {
            "type": "string",
            "format": "uuid",
            "description": "Tenant identifier"
          }
        },
        "required": [
          "X-Tenant-ID"
        ]
      }
    }

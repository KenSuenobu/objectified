<?xml version="1.0" encoding="UTF-8"?>
<!--
  WADL stress example: less common corners of the grammar in one file.

  Exercises every param style (template, query, header, matrix, plain),
  optional params, a method without an id, multiple response statuses per
  method, a representation identified by type instead of element, doc
  elements at several levels, and two sibling resources blocks.
-->
<application xmlns="http://wadl.dev.java.net/2009/02"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:tns="http://example.com/search">
  <doc>Search and admin surfaces of the example search service</doc>

  <grammars>
    <xsd:schema targetNamespace="http://example.com/search">
      <xsd:element name="result" type="tns:SearchResult"/>
      <xsd:complexType name="SearchResult">
        <xsd:sequence>
          <xsd:element name="totalHits" type="xsd:long"/>
          <xsd:element name="tookMillis" type="xsd:int"/>
          <xsd:element name="firstUrl" type="xsd:anyURI"/>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:complexType name="IndexStats">
        <xsd:sequence>
          <xsd:element name="documents" type="xsd:long"/>
          <xsd:element name="sizeBytes" type="xsd:long"/>
        </xsd:sequence>
      </xsd:complexType>
    </xsd:schema>
  </grammars>

  <resources base="https://api.example.com/search/">
    <resource path="query">
      <param name="X-Api-Key" style="header" type="xsd:string"/>
      <method name="GET" id="search">
        <doc>Full-text search with paging and optional filters.</doc>
        <request>
          <param name="q" style="query" type="xsd:string"/>
          <param name="page" style="query" type="xsd:int" required="false"/>
          <param name="pageSize" style="query" type="xsd:int" required="false"/>
          <param name="lang" style="query" type="xsd:string" required="false"/>
        </request>
        <response status="200">
          <representation mediaType="application/xml" element="tns:result"/>
        </response>
        <response status="400"/>
        <response status="429"/>
      </method>
    </resource>
    <resource path="corpus/{collection};view">
      <param name="collection" style="template" type="xsd:string"/>
      <param name="view" style="matrix" type="xsd:string" required="false"/>
      <method name="GET">
        <doc>Method with no id and a matrix param on the resource.</doc>
        <response status="200">
          <representation mediaType="application/xml" type="tns:IndexStats"/>
        </response>
      </method>
    </resource>
  </resources>

  <resources base="https://admin.example.com/search/">
    <resource path="reindex">
      <method name="POST" id="reindex">
        <request>
          <param name="priority" style="plain" type="xsd:string" required="false"/>
          <representation mediaType="application/x-www-form-urlencoded"/>
        </request>
        <response status="202"/>
        <response status="409"/>
      </method>
      <method name="DELETE" id="cancelReindex">
        <response status="204"/>
      </method>
    </resource>
  </resources>
</application>

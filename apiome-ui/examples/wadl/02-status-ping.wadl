<?xml version="1.0" encoding="UTF-8"?>
<!--
  WADL minimal example: the smallest useful WADL document.

  A single resource with one GET method and one response. No grammars,
  no params, no representations beyond a plain-text body.
-->
<application xmlns="http://wadl.dev.java.net/2009/02">
  <resources base="https://api.example.com/">
    <resource path="status">
      <method name="GET" id="getStatus">
        <response status="200">
          <representation mediaType="text/plain"/>
        </response>
      </method>
    </resource>
  </resources>
</application>

{
  "info": {
    "_postman_id": "b1a2c3d4-0000-4000-8000-000000000005",
    "name": "Search Gateway",
    "description": "Stress Postman Collection v2.1 example covering less common corners: disabled query parameters and headers, colon-style path variables, urlencoded and GraphQL body modes, saved response examples with status codes, an unnamed folder passthrough, and HEAD/OPTIONS requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://gateway.example.com" }
  ],
  "item": [
    {
      "name": "Search documents",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "X-Debug-Trace", "value": "1", "disabled": true }
        ],
        "url": {
          "raw": "{{baseUrl}}/search?q=archive&highlight=true",
          "host": ["{{baseUrl}}"],
          "path": ["search"],
          "query": [
            { "key": "q", "value": "archive" },
            { "key": "highlight", "value": "true" },
            { "key": "fuzzy", "value": "true", "disabled": true }
          ]
        },
        "description": "Full-text search; the fuzzy toggle is saved but disabled."
      },
      "response": [
        {
          "name": "Two hits",
          "status": "OK",
          "code": 200,
          "body": {
            "mode": "raw",
            "raw": "{\n  \"total\": 2,\n  \"hits\": [\n    { \"id\": \"d-1\", \"score\": 0.98 },\n    { \"id\": \"d-2\", \"score\": 0.71 }\n  ]\n}",
            "options": { "raw": { "language": "json" } }
          }
        },
        {
          "name": "Bad query",
          "status": "Bad Request",
          "code": 400,
          "body": {
            "mode": "raw",
            "raw": "{\n  \"error\": \"unbalanced quotes in q\"\n}",
            "options": { "raw": { "language": "json" } }
          }
        }
      ]
    },
    {
      "name": "Reindex document",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "priority", "value": "high" },
            { "key": "notify", "value": "false" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/documents/:docId/reindex",
          "host": ["{{baseUrl}}"],
          "path": ["documents", ":docId", "reindex"],
          "variable": [{ "key": "docId", "value": "d-1" }]
        },
        "description": "Urlencoded body mode with a colon-style path variable."
      },
      "response": []
    },
    {
      "name": "GraphQL sidecar query",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "query Stats($index: String) { indexStats(index: $index) { docCount } }",
            "variables": "{ \"index\": \"documents\" }"
          }
        },
        "url": {
          "raw": "{{baseUrl}}/graphql",
          "host": ["{{baseUrl}}"],
          "path": ["graphql"]
        },
        "description": "GraphQL body mode; the gateway proxies it to the stats sidecar."
      },
      "response": []
    },
    {
      "item": [
        {
          "name": "Index health",
          "request": {
            "method": "HEAD",
            "url": {
              "raw": "{{baseUrl}}/indices/documents",
              "host": ["{{baseUrl}}"],
              "path": ["indices", "documents"]
            },
            "description": "Existence probe inside an unnamed folder."
          },
          "response": []
        },
        {
          "name": "Allowed methods",
          "request": {
            "method": "OPTIONS",
            "url": {
              "raw": "{{baseUrl}}/indices/documents",
              "host": ["{{baseUrl}}"],
              "path": ["indices", "documents"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}

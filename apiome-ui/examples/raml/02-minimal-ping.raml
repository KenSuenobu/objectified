#%RAML 1.0
# Minimal RAML 1.0 example — the smallest canonical document: a title, a
# version, and a single resource with one method and one response.
title: Ping Service
version: v1

/ping:
  get:
    description: Liveness probe.
    responses:
      200:
        body:
          application/json:
            type: object

; COSE-shaped grammar: the tagged signature and encryption structures, the header
; maps with their negative-integer labels, and the key structure. Reconstructed from
; the shape of the COSE structures; no upstream text copied.

COSE_Messages = COSE_Untagged_Message / COSE_Tagged_Message

COSE_Untagged_Message = COSE_Sign / COSE_Sign1 / COSE_Encrypt / COSE_Encrypt0 / COSE_Mac0

COSE_Tagged_Message = COSE_Sign_Tagged
                    / COSE_Sign1_Tagged
                    / COSE_Encrypt_Tagged
                    / COSE_Encrypt0_Tagged
                    / COSE_Mac0_Tagged

COSE_Sign_Tagged     = #6.98(COSE_Sign)
COSE_Sign1_Tagged    = #6.18(COSE_Sign1)
COSE_Encrypt_Tagged  = #6.96(COSE_Encrypt)
COSE_Encrypt0_Tagged = #6.16(COSE_Encrypt0)
COSE_Mac0_Tagged     = #6.17(COSE_Mac0)

COSE_Sign = [
  Headers,
  payload: bstr / nil,
  signatures: [+ COSE_Signature],
]

COSE_Signature = [
  Headers,
  signature: bstr,
]

COSE_Sign1 = [
  Headers,
  payload: bstr / nil,
  signature: bstr,
]

COSE_Encrypt = [
  Headers,
  ciphertext: bstr / nil,
  recipients: [+ COSE_Recipient],
]

COSE_Encrypt0 = [
  Headers,
  ciphertext: bstr / nil,
]

COSE_Recipient = [
  Headers,
  ciphertext: bstr / nil,
  ? recipients: [+ COSE_Recipient],
]

COSE_Mac0 = [
  Headers,
  payload: bstr / nil,
  tag: bstr,
]

Headers = (
  protected: empty_or_serialized_map,
  unprotected: header_map,
)

header_map = {
  Generic_Headers,
  * label => values,
}

empty_or_serialized_map = bstr .cbor header_map / bstr .size 0

Generic_Headers = (
  ? 1 => int / tstr,                 ; alg
  ? 2 => [+ label],                  ; crit
  ? 3 => tstr / int,                 ; content type
  ? 4 => bstr,                       ; kid
  ? 5 => bstr,                       ; IV
  ? 6 => bstr,                       ; Partial IV
)

COSE_Key = {
  1 => tstr / int,                   ; kty
  ? 2 => bstr,                       ; kid
  ? 3 => tstr / int,                 ; alg
  ? 4 => [+ (tstr / int)],           ; key_ops
  ? 5 => bstr,                       ; base IV
  * label => values,
}

COSE_KeySet = [+ COSE_Key]

label = int / tstr
values = any

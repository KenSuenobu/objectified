; WebAuthn-shaped grammar: the attestation object, its statement formats, and the
; authenticator extension inputs — the shape a FIDO profile publishes. Reconstructed
; from the shape of those structures; no upstream text copied.

attestation-object = {
  fmt: attestation-format,
  attStmt: attestation-statement,
  authData: bstr,
}

attestation-format = "packed" / "tpm" / "android-key" / "fido-u2f" / "apple" / "none"

attestation-statement = packed-stmt / u2f-stmt / apple-stmt / none-stmt

packed-stmt = {
  alg: cose-alg,
  sig: bstr,
  ? x5c: [+ bstr],
}

u2f-stmt = {
  sig: bstr,
  x5c: [bstr],
}

apple-stmt = {
  x5c: [+ bstr],
}

none-stmt = {}

cose-alg = -7 / -8 / -35 / -36 / -37 / -38 / -39 / -257 / -258 / -259

; Authenticator data is a byte string; its internal layout is described here for
; documentation and for a reader that unpacks it.
authenticator-data-layout = [
  rpIdHash: bstr .size 32,
  flags: uint .bits authenticator-flags,
  signCount: uint .size 4,
  ? attestedCredentialData: attested-credential-data,
  ? extensions: extension-outputs,
]

authenticator-flags = &(
  user-present: 0,
  user-verified: 2,
  backup-eligible: 3,
  backup-state: 4,
  attested-credential-data-included: 6,
  extension-data-included: 7,
)

attested-credential-data = [
  aaguid: bstr .size 16,
  credentialIdLength: uint .size 2,
  credentialId: bstr,
  credentialPublicKey: bstr .cbor cose-key,
]

cose-key = {
  1 => int,                    ; kty
  3 => cose-alg,               ; alg
  * int => any,
}

extension-outputs = {
  ? "credProtect": 1..3,
  ? "hmac-secret": bool,
  ? "largeBlobKey": bstr,
  * tstr => any,
}

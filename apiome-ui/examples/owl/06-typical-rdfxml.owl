<?xml version="1.0" encoding="UTF-8"?>
<!-- RDF/XML serialization: the same ontology model in the syntax OWL tools export. -->
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xml:base="https://example.com/fleet"
         xmlns="https://example.com/fleet#">

  <owl:Ontology rdf:about="https://example.com/fleet">
    <owl:versionInfo>1.4.0</owl:versionInfo>
    <rdfs:label xml:lang="en">Fleet ontology</rdfs:label>
  </owl:Ontology>

  <owl:Class rdf:about="#Vehicle">
    <rdfs:label xml:lang="en">Vehicle</rdfs:label>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#vin"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>

  <owl:Class rdf:about="#Truck">
    <rdfs:subClassOf rdf:resource="#Vehicle"/>
    <owl:disjointWith rdf:resource="#Van"/>
  </owl:Class>

  <owl:Class rdf:about="#Van">
    <rdfs:subClassOf rdf:resource="#Vehicle"/>
  </owl:Class>

  <owl:Class rdf:about="#Depot">
    <rdfs:label xml:lang="en">Depot</rdfs:label>
  </owl:Class>

  <owl:DatatypeProperty rdf:about="#vin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="#Vehicle"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#payloadKg">
    <rdfs:domain rdf:resource="#Truck"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>

  <owl:ObjectProperty rdf:about="#basedAt">
    <rdfs:domain rdf:resource="#Vehicle"/>
    <rdfs:range rdf:resource="#Depot"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#homeTo">
    <owl:inverseOf rdf:resource="#basedAt"/>
    <rdfs:domain rdf:resource="#Depot"/>
    <rdfs:range rdf:resource="#Vehicle"/>
  </owl:ObjectProperty>
</rdf:RDF>

# Paths Comprehensive Example
# Full path code coverage - parameters, request/response bodies, security
#
# 6 request(s) generated by apiome from the canonical model. Every value is an example, not recorded traffic.
#
# Replace before running:
#   {itemId}     value for the 'itemId' path parameter
#   Q            value for the 'q' query parameter
#   X_TENANT_ID  value for the 'X-Tenant-ID' header parameter

@baseUrl = https://api.example.com/v1

### DELETE /api/items/{itemId}
# @name deleteItem
# Delete item
DELETE {{baseUrl}}/api/items/{itemId}

### GET /api/items/{itemId}
# @name getItem
# Get item by ID
GET {{baseUrl}}/api/items/{itemId}
# optional:
#   ?fields=…

### GET /api/search
# @name search
# Search with multiple param locations
GET {{baseUrl}}/api/search?q=Q
# optional:
#   X-Request-ID: …

### POST /api/items
# @name createItem
# Create item
POST {{baseUrl}}/api/items
X-Tenant-ID: X_TENANT_ID
Content-Type: application/json

{
  "name": "kilo-delta"
}

### POST /api/session
# @name createSession
# Create session (cookie param example)
POST {{baseUrl}}/api/session
# optional:
#   X-Client-Version: …
#   ?redirect_uri=…
Content-Type: application/json

{
  "username": "foxtrot-alpha",
  "password": "sample-passphrase"
}

### GET /api/items
# @name listItems
# List items
GET {{baseUrl}}/api/items
# optional:
#   ?page=…
#   ?per_page=…
#   ?q=…
#   ?sort=…
X-Tenant-ID: X_TENANT_ID

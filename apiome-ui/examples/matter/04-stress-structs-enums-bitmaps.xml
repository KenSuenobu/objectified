<?xml version="1.0" encoding="UTF-8"?>
<!--
  Every data-model construct a Matter cluster definition can carry: enums, bitmaps,
  structs (including nested and list-typed fields), attributes with access and quality
  qualifiers, commands with responses, and events with priorities.
-->
<configurator>
  <domain name="Measurement &amp; Sensing"/>

  <enum name="MeasurementTypeEnum" type="enum16">
    <cluster code="0xFFF1"/>
    <item name="Unspecified" value="0x0000"/>
    <item name="Voltage" value="0x0001"/>
    <item name="ActiveCurrent" value="0x0002"/>
    <item name="ReactiveCurrent" value="0x0003"/>
    <item name="ActivePower" value="0x0005"/>
  </enum>

  <enum name="StatusEnum" type="enum8">
    <cluster code="0xFFF1"/>
    <item name="Ok" value="0x00"/>
    <item name="Degraded" value="0x01"/>
    <item name="Failed" value="0x02"/>
  </enum>

  <bitmap name="Feature" type="bitmap32">
    <cluster code="0xFFF1"/>
    <field name="DirectCurrent" mask="0x1"/>
    <field name="AlternatingCurrent" mask="0x2"/>
    <field name="PolyphasePower" mask="0x4"/>
    <field name="Harmonics" mask="0x8"/>
  </bitmap>

  <struct name="MeasurementAccuracyRangeStruct">
    <cluster code="0xFFF1"/>
    <item fieldId="0" name="RangeMin" type="int64s"/>
    <item fieldId="1" name="RangeMax" type="int64s"/>
    <item fieldId="2" name="PercentMax" type="percent100ths" optional="true"/>
    <item fieldId="3" name="PercentMin" type="percent100ths" optional="true"/>
    <item fieldId="4" name="FixedMax" type="int64u" optional="true"/>
  </struct>

  <struct name="MeasurementAccuracyStruct">
    <cluster code="0xFFF1"/>
    <item fieldId="0" name="MeasurementType" type="MeasurementTypeEnum"/>
    <item fieldId="1" name="Measured" type="boolean" default="false"/>
    <item fieldId="2" name="MinMeasuredValue" type="int64s"/>
    <item fieldId="3" name="MaxMeasuredValue" type="int64s"/>
    <item fieldId="4" name="AccuracyRanges" array="true"
          type="MeasurementAccuracyRangeStruct" minLength="1"/>
  </struct>

  <struct name="HarmonicMeasurementStruct">
    <cluster code="0xFFF1"/>
    <item fieldId="0" name="Order" type="int8u" min="1"/>
    <item fieldId="1" name="Measurement" type="int64s" isNullable="true"/>
  </struct>

  <cluster>
    <domain>Measurement &amp; Sensing</domain>
    <name>Electrical Power Measurement</name>
    <code>0xFFF1</code>
    <define>ELECTRICAL_POWER_MEASUREMENT_CLUSTER</define>
    <description>Coverage cluster: every construct the data model admits.</description>

    <features>
      <feature bit="0" code="DIRC" name="DirectCurrent" summary="Direct current measurement.">
        <optionalConform choice="a" more="true"/>
      </feature>
      <feature bit="1" code="ALTC" name="AlternatingCurrent" summary="Alternating current.">
        <optionalConform choice="a" more="true"/>
      </feature>
      <feature bit="3" code="HARM" name="Harmonics" summary="Harmonic measurement.">
        <optionalConform/>
      </feature>
    </features>

    <!-- Attribute qualities: nullable, read-only, writable with access, reportable,
         list-typed, and one with a fixed quality. -->
    <attribute side="server" code="0x0000" define="POWER_MODE" type="MeasurementTypeEnum"
               writable="false">PowerMode</attribute>
    <attribute side="server" code="0x0001" define="NUMBER_OF_PHASES" type="int8u"
               writable="false" isNullable="true" optional="true">NumberOfMeasurementTypes</attribute>
    <attribute side="server" code="0x0002" define="ACCURACY" type="array"
               entryType="MeasurementAccuracyStruct" writable="false" length="16">Accuracy</attribute>
    <attribute side="server" code="0x0003" define="RANGES" type="array"
               entryType="MeasurementAccuracyRangeStruct" writable="false" optional="true"
               reportable="true">Ranges</attribute>
    <attribute side="server" code="0x0004" define="VOLTAGE" type="int64s" writable="false"
               isNullable="true" reportable="true" optional="true">Voltage</attribute>
    <attribute side="server" code="0x0005" define="ACTIVE_CURRENT" type="int64s"
               writable="false" isNullable="true" reportable="true" optional="true">ActiveCurrent</attribute>
    <attribute side="server" code="0x0010" define="THRESHOLD" type="int64s" writable="true"
               optional="true" min="0" max="1000000">Threshold
      <access op="read" privilege="view"/>
      <access op="write" privilege="manage"/>
    </attribute>
    <attribute side="server" code="0x0011" define="STATUS" type="StatusEnum"
               writable="false" default="Ok" reportable="true">Status</attribute>

    <!-- Command with a response command. -->
    <command source="client" code="0x00" name="StartMeasurement" optional="true"
             response="StartMeasurementResponse">
      <description>Begin a measurement window.</description>
      <arg name="DurationSeconds" type="int32u" min="1" max="86400"/>
      <arg name="Types" type="MeasurementTypeEnum" array="true" optional="true"/>
      <access op="invoke" privilege="operate"/>
    </command>

    <command source="server" code="0x01" name="StartMeasurementResponse" optional="true"
             disableDefaultResponse="true">
      <arg name="Accepted" type="boolean"/>
      <arg name="WindowId" type="int32u"/>
      <arg name="Reason" type="char_string" optional="true" length="64"/>
    </command>

    <command source="client" code="0x02" name="ResetAccumulators" optional="true">
      <access op="invoke" privilege="manage"/>
    </command>

    <!-- Events at three priorities, one with a list field and a nullable field. -->
    <event source="server" code="0x00" name="MeasurementPeriodRanges" priority="info"
           optional="true">
      <description>Emitted when a measurement window closes.</description>
      <field id="0" name="Ranges" type="MeasurementAccuracyRangeStruct" array="true"/>
      <field id="1" name="ClosedAt" type="epoch_s"/>
    </event>

    <event source="server" code="0x01" name="HarmonicsReported" priority="debug"
           optional="true">
      <field id="0" name="Measurements" type="HarmonicMeasurementStruct" array="true"/>
    </event>

    <event source="server" code="0x02" name="MeasurementFault" priority="critical">
      <field id="0" name="Status" type="StatusEnum"/>
      <field id="1" name="Detail" type="char_string" isNullable="true" length="128"/>
    </event>
  </cluster>
</configurator>

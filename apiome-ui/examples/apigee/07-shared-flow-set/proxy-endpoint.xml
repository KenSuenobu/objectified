<?xml version="1.0" encoding="UTF-8"?>
<!--
  Root of the set: a proxy endpoint whose security and logging steps are not defined
  here at all — they are FlowCallouts into a shared flow bundle deployed separately.
  Reading this file alone shows two steps whose behaviour is unknown.
-->
<ProxyEndpoint name="default">
    <Description>Shipments proxy: security delegated to a shared flow.</Description>
    <PreFlow name="PreFlow">
        <Request>
            <Step><Name>Call-Security-SharedFlow</Name></Step>
        </Request>
        <Response>
            <Step><Name>Call-Logging-SharedFlow</Name></Step>
        </Response>
    </PreFlow>
    <Flows>
        <Flow name="ListShipments">
            <Condition>(proxy.pathsuffix MatchesPath "/shipments") and (request.verb = "GET")</Condition>
            <Request/>
            <Response/>
        </Flow>
        <Flow name="GetShipment">
            <Condition>(proxy.pathsuffix MatchesPath "/shipments/*") and (request.verb = "GET")</Condition>
            <Request/>
            <Response/>
        </Flow>
    </Flows>
    <PostFlow name="PostFlow"><Request/><Response/></PostFlow>
    <HTTPProxyConnection>
        <BasePath>/v2/shipments</BasePath>
        <VirtualHost>secure</VirtualHost>
    </HTTPProxyConnection>
    <RouteRule name="default">
        <TargetEndpoint>default</TargetEndpoint>
    </RouteRule>
</ProxyEndpoint>

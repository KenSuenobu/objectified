<?xml version="1.0" encoding="UTF-8"?>
<con:soapui-project xmlns:con="http://eviware.com/soapui/config"
                    id="7a1c0000-0000-4000-8000-000000000010"
                    activeEnvironment="Default"
                    name="Orders API"
                    resourceRoot="${projectDir}">
  <con:settings/>

  <con:interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:type="con:RestService"
                 id="7a1c0000-0000-4000-8000-000000000011"
                 name="Orders"
                 type="rest"
                 basePath="/v2">
    <con:settings/>
    <con:endpoints>
      <con:endpoint>https://api.example.com</con:endpoint>
      <con:endpoint>https://staging.example.com</con:endpoint>
    </con:endpoints>

    <con:resource name="orders" path="/orders" id="7a1c0000-0000-4000-8000-000000000012">
      <con:settings/>
      <con:parameters>
        <con:parameter>
          <con:name>status</con:name>
          <con:value>new</con:value>
          <con:style>QUERY</con:style>
          <con:type xmlns:xs="http://www.w3.org/2001/XMLSchema">xs:string</con:type>
        </con:parameter>
        <con:parameter>
          <con:name>limit</con:name>
          <con:value>25</con:value>
          <con:style>QUERY</con:style>
          <con:type xmlns:xs="http://www.w3.org/2001/XMLSchema">xs:int</con:type>
        </con:parameter>
      </con:parameters>

      <con:method name="listOrders" id="7a1c0000-0000-4000-8000-000000000013" method="GET">
        <con:settings/>
        <con:parameters/>
        <con:request name="Request 1" id="7a1c0000-0000-4000-8000-000000000014" mediaType="application/json">
          <con:settings/>
          <con:endpoint>https://api.example.com</con:endpoint>
          <con:request/>
          <con:credentials>
            <con:authType>No Authorization</con:authType>
          </con:credentials>
          <con:jmsConfig JMSDeliveryMode="PERSISTENT"/>
          <con:parameters/>
        </con:request>
      </con:method>

      <con:method name="placeOrder" id="7a1c0000-0000-4000-8000-000000000015" method="POST">
        <con:settings/>
        <con:parameters/>
        <con:representation type="REQUEST">
          <con:mediaType>application/json</con:mediaType>
        </con:representation>
        <con:representation type="RESPONSE">
          <con:mediaType>application/json</con:mediaType>
          <con:status>201</con:status>
        </con:representation>
        <con:request name="Request 1" id="7a1c0000-0000-4000-8000-000000000016" mediaType="application/json" postQueryString="false">
          <con:settings/>
          <con:endpoint>https://api.example.com</con:endpoint>
          <con:request>{
  "customerId": "CUS-000123",
  "lines": [{ "sku": "WID-0001", "quantity": 2 }]
}</con:request>
          <con:parameters/>
        </con:request>
      </con:method>
    </con:resource>

    <con:resource name="order" path="/orders/{orderId}" id="7a1c0000-0000-4000-8000-000000000017">
      <con:settings/>
      <con:parameters>
        <con:parameter>
          <con:name>orderId</con:name>
          <con:value>ORD-00010042</con:value>
          <con:style>TEMPLATE</con:style>
          <con:type xmlns:xs="http://www.w3.org/2001/XMLSchema">xs:string</con:type>
        </con:parameter>
      </con:parameters>
      <con:method name="getOrder" id="7a1c0000-0000-4000-8000-000000000018" method="GET">
        <con:settings/>
        <con:parameters/>
        <con:request name="Request 1" id="7a1c0000-0000-4000-8000-000000000019" mediaType="application/json">
          <con:settings/>
          <con:endpoint>https://api.example.com</con:endpoint>
          <con:request/>
          <con:parameters>
            <con:entry key="orderId" value="ORD-00010042"/>
          </con:parameters>
        </con:request>
      </con:method>
      <con:method name="cancelOrder" id="7a1c0000-0000-4000-8000-00000000001a" method="DELETE">
        <con:settings/>
        <con:parameters/>
        <con:request name="Request 1" id="7a1c0000-0000-4000-8000-00000000001b">
          <con:settings/>
          <con:endpoint>https://api.example.com</con:endpoint>
          <con:request/>
          <con:parameters>
            <con:entry key="orderId" value="ORD-00010042"/>
          </con:parameters>
        </con:request>
      </con:method>
    </con:resource>
  </con:interface>

  <con:properties>
    <con:property>
      <con:name>baseUrl</con:name>
      <con:value>https://api.example.com</con:value>
    </con:property>
  </con:properties>
</con:soapui-project>

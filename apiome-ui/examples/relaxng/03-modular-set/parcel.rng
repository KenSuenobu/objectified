<?xml version="1.0" encoding="UTF-8"?>
<element name="parcelContent" xmlns="http://relaxng.org/ns/structure/1.0"
         datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <attribute name="weightKg">
    <data type="decimal"/>
  </attribute>
  <optional>
    <attribute name="fragile">
      <data type="boolean"/>
    </attribute>
  </optional>
  <empty/>
</element>

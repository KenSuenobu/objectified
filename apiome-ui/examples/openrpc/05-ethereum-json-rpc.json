{
  "_comment": "OpenRPC real-world example — hand-authored reconstruction of the shape of the Ethereum JSON-RPC API, the flagship public OpenRPC deployment: eth_blockNumber, eth_getBalance, eth_getTransactionByHash, and eth_sendRawTransaction with hex-quantity and hash schemas. No third-party text copied.",
  "openrpc": "1.3.2",
  "info": {
    "title": "Ethereum JSON-RPC (subset)",
    "version": "1.0.0",
    "description": "A small, faithful reconstruction of the shape of the Ethereum node RPC surface."
  },
  "servers": [
    { "name": "mainnet", "url": "https://rpc.example.com/mainnet" }
  ],
  "methods": [
    {
      "name": "eth_blockNumber",
      "summary": "Height of the most recent block.",
      "params": [],
      "result": {
        "name": "blockNumber",
        "schema": { "$ref": "#/components/schemas/Quantity" }
      }
    },
    {
      "name": "eth_getBalance",
      "summary": "Balance of an address at a given block.",
      "params": [
        { "name": "address", "required": true, "schema": { "$ref": "#/components/schemas/Address" } },
        { "name": "block", "required": true, "schema": { "$ref": "#/components/schemas/BlockNumberOrTag" } }
      ],
      "result": {
        "name": "balance",
        "schema": { "$ref": "#/components/schemas/Quantity" }
      }
    },
    {
      "name": "eth_getTransactionByHash",
      "summary": "Look up a transaction by its hash.",
      "params": [
        { "name": "transactionHash", "required": true, "schema": { "$ref": "#/components/schemas/Hash32" } }
      ],
      "result": {
        "name": "transaction",
        "schema": {
          "oneOf": [
            { "$ref": "#/components/schemas/Transaction" },
            { "type": "null", "description": "Not found." }
          ]
        }
      }
    },
    {
      "name": "eth_sendRawTransaction",
      "summary": "Broadcast a signed, RLP-encoded transaction.",
      "params": [
        { "name": "signedTransaction", "required": true, "schema": { "$ref": "#/components/schemas/HexBytes" } }
      ],
      "result": {
        "name": "transactionHash",
        "schema": { "$ref": "#/components/schemas/Hash32" }
      }
    }
  ],
  "components": {
    "schemas": {
      "Address": {
        "type": "string",
        "description": "20-byte account address, 0x-prefixed hex.",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      },
      "Hash32": {
        "type": "string",
        "description": "32-byte hash, 0x-prefixed hex.",
        "pattern": "^0x[0-9a-fA-F]{64}$"
      },
      "Quantity": {
        "type": "string",
        "description": "Hex-encoded unsigned integer quantity.",
        "pattern": "^0x[0-9a-fA-F]+$"
      },
      "HexBytes": {
        "type": "string",
        "description": "Arbitrary 0x-prefixed byte string.",
        "pattern": "^0x[0-9a-fA-F]*$"
      },
      "BlockNumberOrTag": {
        "description": "Either a hex block number or a named tag.",
        "oneOf": [
          { "$ref": "#/components/schemas/Quantity" },
          { "type": "string", "enum": ["latest", "earliest", "pending", "safe", "finalized"] }
        ]
      },
      "Transaction": {
        "type": "object",
        "description": "A transaction as returned by the node.",
        "required": ["hash", "from", "value", "nonce"],
        "properties": {
          "hash": { "$ref": "#/components/schemas/Hash32" },
          "from": { "$ref": "#/components/schemas/Address" },
          "to": {
            "oneOf": [
              { "$ref": "#/components/schemas/Address" },
              { "type": "null", "description": "Contract creation." }
            ]
          },
          "value": { "$ref": "#/components/schemas/Quantity" },
          "gas": { "$ref": "#/components/schemas/Quantity" },
          "gasPrice": { "$ref": "#/components/schemas/Quantity" },
          "nonce": { "$ref": "#/components/schemas/Quantity" },
          "input": { "$ref": "#/components/schemas/HexBytes" }
        }
      }
    }
  }
}

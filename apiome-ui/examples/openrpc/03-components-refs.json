{
  "_comment": "OpenRPC composition example — reuse through components: methods share parameter and result shapes via $ref into components.schemas, schemas reference each other (Order embeds Customer and an array of LineItem), and reusable contentDescriptors and errors are referenced from more than one method.",
  "openrpc": "1.3.2",
  "info": {
    "title": "Order Desk API",
    "version": "2.0.0",
    "description": "JSON-RPC order service built almost entirely from shared components."
  },
  "methods": [
    {
      "name": "createOrder",
      "summary": "Create a new order for a customer.",
      "params": [
        { "$ref": "#/components/contentDescriptors/CustomerId" },
        {
          "name": "items",
          "required": true,
          "schema": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LineItem" }
          }
        }
      ],
      "result": {
        "name": "order",
        "schema": { "$ref": "#/components/schemas/Order" }
      },
      "errors": [
        { "$ref": "#/components/errors/CustomerNotFound" }
      ]
    },
    {
      "name": "getOrder",
      "summary": "Fetch an existing order by id.",
      "params": [
        { "name": "orderId", "required": true, "schema": { "$ref": "#/components/schemas/OrderId" } }
      ],
      "result": {
        "name": "order",
        "schema": { "$ref": "#/components/schemas/Order" }
      }
    },
    {
      "name": "listOrders",
      "summary": "List all orders belonging to a customer.",
      "params": [
        { "$ref": "#/components/contentDescriptors/CustomerId" }
      ],
      "result": {
        "name": "orders",
        "schema": {
          "type": "array",
          "items": { "$ref": "#/components/schemas/Order" }
        }
      },
      "errors": [
        { "$ref": "#/components/errors/CustomerNotFound" }
      ]
    }
  ],
  "components": {
    "contentDescriptors": {
      "CustomerId": {
        "name": "customerId",
        "required": true,
        "description": "Identifier of the customer placing or owning orders.",
        "schema": { "type": "string" }
      }
    },
    "errors": {
      "CustomerNotFound": {
        "code": -32001,
        "message": "Customer not found"
      }
    },
    "schemas": {
      "OrderId": {
        "type": "string",
        "description": "Opaque order identifier."
      },
      "Customer": {
        "type": "object",
        "description": "A customer of the order desk.",
        "required": ["customerId", "displayName"],
        "properties": {
          "customerId": { "type": "string" },
          "displayName": { "type": "string" }
        }
      },
      "LineItem": {
        "type": "object",
        "description": "One line of an order.",
        "required": ["sku", "quantity"],
        "properties": {
          "sku": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "note": { "type": "string" }
        }
      },
      "Order": {
        "type": "object",
        "description": "An order composed from the shared Customer and LineItem schemas.",
        "required": ["orderId", "customer", "items"],
        "properties": {
          "orderId": { "$ref": "#/components/schemas/OrderId" },
          "customer": { "$ref": "#/components/schemas/Customer" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LineItem" }
          }
        }
      }
    }
  }
}

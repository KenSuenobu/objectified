*********************************************************************
* Insurance policy database as an IMS estate keeps one: a four-level *
* hierarchy, packed monetary fields, a variable-length note segment  *
* and one secondary index. Reconstructed shape; no upstream text     *
* copied.                                                            *
*********************************************************************
         DBD   NAME=POLICYDB,ACCESS=(HIDAM,VSAM)
         DATASET DD1=POLPRIME,DEVICE=3390,SIZE=8192,FRSPC=(5,10)
*
         SEGM  NAME=POLICY,BYTES=320,PARENT=0,POINTER=(TWINBWD)
         LCHILD NAME=(POLICYX,POLIXDB),POINTER=INDX
         FIELD NAME=(POLNUM,SEQ,U),BYTES=12,START=1,TYPE=C
         FIELD NAME=POLPROD,BYTES=6,START=13,TYPE=C
         FIELD NAME=POLSTAT,BYTES=1,START=19,TYPE=C
         FIELD NAME=POLEFFDT,BYTES=8,START=20,TYPE=C
         FIELD NAME=POLEXPDT,BYTES=8,START=28,TYPE=C
         FIELD NAME=POLPREM,BYTES=8,START=36,TYPE=P
         FIELD NAME=POLCCY,BYTES=3,START=44,TYPE=C
         FIELD NAME=POLBROKR,BYTES=8,START=47,TYPE=C
* Secondary index by broker, so a broker's book can be walked directly.
         LCHILD NAME=(BROKERX,POLIXDB2),POINTER=INDX
         XDFLD NAME=XBROKER,SEGMENT=POLICY,SRCH=(POLBROKR),             X
               SUBSEQ=(POLNUM),NULLVAL=BLANK
*
         SEGM  NAME=INSURED,BYTES=180,PARENT=POLICY
         FIELD NAME=(INSSEQ,SEQ,U),BYTES=3,START=1,TYPE=C
         FIELD NAME=INSNAME,BYTES=60,START=4,TYPE=C
         FIELD NAME=INSDOB,BYTES=8,START=64,TYPE=C
         FIELD NAME=INSROLE,BYTES=2,START=72,TYPE=C
         FIELD NAME=INSADDR1,BYTES=35,START=74,TYPE=C
         FIELD NAME=INSCITY,BYTES=25,START=109,TYPE=C
         FIELD NAME=INSPOST,BYTES=10,START=134,TYPE=C
         FIELD NAME=INSCTRY,BYTES=3,START=144,TYPE=C
*
         SEGM  NAME=COVERAGE,BYTES=140,PARENT=POLICY
         FIELD NAME=(COVCODE,SEQ,U),BYTES=6,START=1,TYPE=C
         FIELD NAME=COVLIMIT,BYTES=8,START=7,TYPE=P
         FIELD NAME=COVDEDUC,BYTES=8,START=15,TYPE=P
         FIELD NAME=COVPREM,BYTES=8,START=23,TYPE=P
         FIELD NAME=COVCCY,BYTES=3,START=31,TYPE=C
         FIELD NAME=COVSTAT,BYTES=1,START=34,TYPE=C
*
         SEGM  NAME=CLAIM,BYTES=200,PARENT=COVERAGE
         FIELD NAME=(CLAIMNO,SEQ,U),BYTES=12,START=1,TYPE=C
         FIELD NAME=CLMDATE,BYTES=8,START=13,TYPE=C
         FIELD NAME=CLMSTAT,BYTES=1,START=21,TYPE=C
         FIELD NAME=CLMRESRV,BYTES=8,START=22,TYPE=P
         FIELD NAME=CLMPAID,BYTES=8,START=30,TYPE=P
         FIELD NAME=CLMCCY,BYTES=3,START=38,TYPE=C
*
         SEGM  NAME=CLMNOTE,BYTES=(600,24),PARENT=CLAIM
         FIELD NAME=(NOTEDT,SEQ,M),BYTES=8,START=1,TYPE=C
         FIELD NAME=NOTEUSER,BYTES=8,START=9,TYPE=C
         FIELD NAME=NOTETEXT,BYTES=560,START=17,TYPE=C
*
         DBDGEN
         FINISH
         END

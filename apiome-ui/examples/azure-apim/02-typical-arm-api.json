{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "ApimServiceName": { "type": "string", "defaultValue": "example-apim" }
  },
  "resources": [
    {
      "type": "Microsoft.ApiManagement/service/apis",
      "apiVersion": "2022-08-01",
      "name": "[concat(parameters('ApimServiceName'), '/orders-api')]",
      "properties": {
        "displayName": "Orders API",
        "apiRevision": "3",
        "description": "Order management for the storefront.",
        "subscriptionRequired": true,
        "path": "orders",
        "protocols": ["https"],
        "isCurrent": true,
        "apiVersion": "v2",
        "apiVersionSetId": "orders-version-set",
        "serviceUrl": "https://orders.internal.example.com/v2",
        "subscriptionKeyParameterNames": {
          "header": "Ocp-Apim-Subscription-Key",
          "query": "subscription-key"
        }
      }
    },
    {
      "type": "Microsoft.ApiManagement/service/apis/operations",
      "apiVersion": "2022-08-01",
      "name": "[concat(parameters('ApimServiceName'), '/orders-api/list-orders')]",
      "dependsOn": [
        "[resourceId('Microsoft.ApiManagement/service/apis', parameters('ApimServiceName'), 'orders-api')]"
      ],
      "properties": {
        "displayName": "List orders",
        "method": "GET",
        "urlTemplate": "/orders",
        "templateParameters": [],
        "request": {
          "queryParameters": [
            { "name": "status", "type": "string", "required": false },
            { "name": "limit", "type": "integer", "required": false, "defaultValue": "25" }
          ],
          "headers": []
        },
        "responses": [
          { "statusCode": 200, "description": "Matching orders", "representations": [{ "contentType": "application/json" }] },
          { "statusCode": 401, "description": "Unauthorized" }
        ]
      }
    },
    {
      "type": "Microsoft.ApiManagement/service/apis/operations",
      "apiVersion": "2022-08-01",
      "name": "[concat(parameters('ApimServiceName'), '/orders-api/get-order')]",
      "properties": {
        "displayName": "Get order",
        "method": "GET",
        "urlTemplate": "/orders/{orderId}",
        "templateParameters": [
          { "name": "orderId", "type": "string", "required": true, "description": "Order identifier" }
        ],
        "responses": [
          { "statusCode": 200, "description": "One order" },
          { "statusCode": 404, "description": "Unknown order" }
        ]
      }
    },
    {
      "type": "Microsoft.ApiManagement/service/apis/operations/policies",
      "apiVersion": "2022-08-01",
      "name": "[concat(parameters('ApimServiceName'), '/orders-api/get-order/policy')]",
      "properties": {
        "format": "xml",
        "value": "<policies><inbound><base /><cache-lookup vary-by-developer=\"false\" vary-by-developer-groups=\"false\" downstream-caching-type=\"none\" /><rewrite-uri template=\"/v2/orders/{orderId}\" /></inbound><backend><base /></backend><outbound><base /><cache-store duration=\"60\" /></outbound><on-error><base /></on-error></policies>"
      }
    },
    {
      "type": "Microsoft.ApiManagement/service/apis/policies",
      "apiVersion": "2022-08-01",
      "name": "[concat(parameters('ApimServiceName'), '/orders-api/policy')]",
      "properties": {
        "format": "xml",
        "value": "<policies><inbound><base /><set-backend-service base-url=\"https://orders.internal.example.com/v2\" /><rate-limit-by-key calls=\"600\" renewal-period=\"60\" counter-key=\"@(context.Subscription.Id)\" /></inbound><backend><base /></backend><outbound><base /></outbound><on-error><base /></on-error></policies>"
      }
    }
  ]
}

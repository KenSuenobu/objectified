          "description": "Create a reservation.",
          "parameters": {
            "Authorization": {
              "type": "string",
              "location": "header",
              "required": true,
              "description": "Bearer token."
            }
          },
          "request": {
            "$ref": "Reservation"
          },
          "response": {
            "$ref": "Reservation"
          }
        },
        "get": {
          "id": "booking.reservations.get",
          "path": "reservations/{reservationId}",
          "httpMethod": "GET",
          "parameters": {
            "reservationId": {
              "type": "string",
              "location": "path",
              "required": true

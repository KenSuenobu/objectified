{
  "_comment": "Typical Discovery document with header parameters and document-level common parameters.",
  "kind": "discovery#restDescription",
  "discoveryVersion": "v1",
  "id": "booking:v1",
  "name": "booking",
  "version": "v1",
  "title": "Booking API",
  "description": "Reserve rooms.",
  "protocol": "rest",
  "baseUrl": "https://booking.example.com/",
  "rootUrl": "https://booking.example.com/",
  "servicePath": "booking/v1/",
  "parameters": {

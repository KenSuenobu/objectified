      "optional": true,
      "fields": [
        { "field": "id", "type": "int32", "optional": false },
        { "field": "first_name", "type": "string", "optional": false },
        { "field": "last_name", "type": "string", "optional": false },
        { "field": "email", "type": "string", "optional": false },
        {
          "field": "credit_limit",
          "type": "bytes",
          "name": "org.apache.kafka.connect.data.Decimal",
          "version": 1,
          "optional": true,
          "parameters": { "scale": "2", "connect.decimal.precision": "10" }
        },
        {
          "field": "created_at",
          "type": "int64",
          "name": "io.debezium.time.MicroTimestamp",
          "version": 1,
          "optional": true
        }
      ]
    },
    {
      "field": "after",
      "type": "struct",
      "name": "example.inventory.customers.Value",
      "optional": true,
      "fields": [
        { "field": "id", "type": "int32", "optional": false },
        { "field": "first_name", "type": "string", "optional": false },
        { "field": "last_name", "type": "string", "optional": false },
        { "field": "email", "type": "string", "optional": false },
        {
          "field": "credit_limit",
          "type": "bytes",
          "name": "org.apache.kafka.connect.data.Decimal",
          "version": 1,
          "optional": true,
          "parameters": { "scale": "2", "connect.decimal.precision": "10" }
        },
        {
          "field": "created_at",
          "type": "int64",
          "name": "io.debezium.time.MicroTimestamp",
          "version": 1,
          "optional": true
        }
      ]
    },
    {
      "field": "source",
      "type": "struct",
      "name": "io.debezium.connector.postgresql.Source",
      "optional": false,
      "fields": [
        { "field": "version", "type": "string", "optional": false },
        { "field": "connector", "type": "string", "optional": false },
        { "field": "name", "type": "string", "optional": false },
        { "field": "ts_ms", "type": "int64", "optional": false },
        {
          "field": "snapshot",
          "type": "string",
          "name": "io.debezium.data.Enum",
          "version": 1,
          "optional": true,
          "default": "false",
          "parameters": { "allowed": "true,last,false,incremental" }
        },
        { "field": "db", "type": "string", "optional": false },
        { "field": "schema", "type": "string", "optional": false },
        { "field": "table", "type": "string", "optional": false },
        { "field": "txId", "type": "int64", "optional": true },
        { "field": "lsn", "type": "int64", "optional": true }
      ]
    },
    { "field": "op", "type": "string", "optional": false },
    { "field": "ts_ms", "type": "int64", "optional": true },
    {
      "field": "transaction",
      "type": "struct",
      "name": "event.block",
      "version": 1,
      "optional": true,
      "fields": [
        { "field": "id", "type": "string", "optional": false },
        { "field": "total_order", "type": "int64", "optional": false },
        { "field": "data_collection_order", "type": "int64", "optional": false }
      ]
    }
  ]

// Modeled after the WASI key-value store proposal's interface surface
// (wasi:keyvalue), hand-authored for the apiome import examples.
package wasi:keyvalue@0.2.0;

interface store {
    /// The set of errors a key-value operation may fail with.
    variant error {
        no-such-store,
        access-denied,
        other(string),
    }

    /// One page of keys plus the cursor to fetch the next page.
    record key-response {
        keys: list<string>,
        cursor: option<string>,
    }

    resource bucket {
        get: func(key: string) -> result<option<list<u8>>, error>;
        set: func(key: string, value: list<u8>) -> result<_, error>;
        delete: func(key: string) -> result<_, error>;
        exists: func(key: string) -> result<bool, error>;
        list-keys: func(cursor: option<string>) -> result<key-response, error>;
    }

    open: func(identifier: string) -> result<bucket, error>;
}

interface atomics {
    use store.{bucket, error};

    increment: func(target: borrow<bucket>, key: string, delta: s64) -> result<s64, error>;
}

interface batch {
    use store.{bucket, error};

    get-many: func(target: borrow<bucket>, keys: list<string>) -> result<list<option<tuple<string, list<u8>>>>, error>;
    set-many: func(target: borrow<bucket>, key-values: list<tuple<string, list<u8>>>) -> result<_, error>;
}

world imports {
    import store;
    import atomics;
    import batch;
}

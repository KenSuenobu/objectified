<?xml version="1.0" encoding="UTF-8"?>
<!--
  OData v4 CSDL (EDMX) real-world example — shaped like the public TripPin
  reference service (services.odata.org), the canonical OData v4 demo API.

  Hand-authored reconstruction of the TripPin shape: People with trips,
  airlines and airports, a location complex-type hierarchy, a gender enum,
  and a `Me` singleton. No third-party text copied.
-->
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:DataServices>
    <Schema Namespace="Example.TripPin" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <EnumType Name="PersonGender">
        <Member Name="Male" Value="0"/>
        <Member Name="Female" Value="1"/>
        <Member Name="Unknown" Value="2"/>
      </EnumType>

      <ComplexType Name="City">
        <Property Name="Name" Type="Edm.String"/>
        <Property Name="CountryRegion" Type="Edm.String"/>
        <Property Name="Region" Type="Edm.String"/>
      </ComplexType>

      <ComplexType Name="Location">
        <Property Name="Address" Type="Edm.String"/>
        <Property Name="City" Type="Example.TripPin.City"/>
      </ComplexType>

      <EntityType Name="Person">
        <Key>
          <PropertyRef Name="UserName"/>
        </Key>
        <Property Name="UserName" Type="Edm.String" Nullable="false"/>
        <Property Name="FirstName" Type="Edm.String" Nullable="false"/>
        <Property Name="LastName" Type="Edm.String"/>
        <Property Name="Emails" Type="Collection(Edm.String)"/>
        <Property Name="AddressInfo" Type="Collection(Example.TripPin.Location)"/>
        <Property Name="Gender" Type="Example.TripPin.PersonGender"/>
        <NavigationProperty Name="Friends" Type="Collection(Example.TripPin.Person)"/>
        <NavigationProperty Name="Trips" Type="Collection(Example.TripPin.Trip)" ContainsTarget="true"/>
      </EntityType>

      <EntityType Name="Trip">
        <Key>
          <PropertyRef Name="TripId"/>
        </Key>
        <Property Name="TripId" Type="Edm.Int32" Nullable="false"/>
        <Property Name="Name" Type="Edm.String"/>
        <Property Name="Budget" Type="Edm.Single"/>
        <Property Name="Description" Type="Edm.String"/>
        <Property Name="StartsAt" Type="Edm.DateTimeOffset"/>
        <Property Name="EndsAt" Type="Edm.DateTimeOffset"/>
      </EntityType>

      <EntityType Name="Airline">
        <Key>
          <PropertyRef Name="AirlineCode"/>
        </Key>
        <Property Name="AirlineCode" Type="Edm.String" Nullable="false"/>
        <Property Name="Name" Type="Edm.String"/>
      </EntityType>

      <EntityType Name="Airport">
        <Key>
          <PropertyRef Name="IcaoCode"/>
        </Key>
        <Property Name="IcaoCode" Type="Edm.String" Nullable="false"/>
        <Property Name="IataCode" Type="Edm.String"/>
        <Property Name="Name" Type="Edm.String"/>
        <Property Name="Location" Type="Example.TripPin.Location"/>
      </EntityType>

      <EntityContainer Name="TripPinService">
        <EntitySet Name="People" EntityType="Example.TripPin.Person"/>
        <EntitySet Name="Airlines" EntityType="Example.TripPin.Airline"/>
        <EntitySet Name="Airports" EntityType="Example.TripPin.Airport"/>
        <Singleton Name="Me" Type="Example.TripPin.Person"/>
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal OData v4 CSDL (EDMX) document — the smallest canonical service.

  One EntityType with a single key property and one EntitySet exposing it.
  Demonstrates the bare structural skeleton every EDMX shares: Edmx,
  DataServices, Schema, EntityType, EntityContainer.
-->
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:DataServices>
    <Schema Namespace="Example.Minimal" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <EntityType Name="Item">
        <Key>
          <PropertyRef Name="Id"/>
        </Key>
        <Property Name="Id" Type="Edm.Int32" Nullable="false"/>
      </EntityType>

      <EntityContainer Name="Container">
        <EntitySet Name="Items" EntityType="Example.Minimal.Item"/>
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>

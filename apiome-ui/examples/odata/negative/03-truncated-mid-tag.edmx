  DataServices, Schema, EntityType, EntityContainer.
-->
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:DataServices>
    <Schema Namespace="Example.Minimal" xmlns="http://docs.o
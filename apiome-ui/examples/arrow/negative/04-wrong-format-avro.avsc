{
  "type": "record",
  "name": "Order",
  "namespace": "com.example.orders",
  "fields": [
    { "name": "orderId", "type": "string" },
    { "name": "placedAt", "type": { "type": "long", "logicalType": "timestamp-micros" } },
    { "name": "total", "type": { "type": "bytes", "logicalType": "decimal", "precision": 18, "scale": 4 } }
  ]
}

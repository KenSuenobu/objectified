# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/playwright-report/
/playwright-report-journey/
/playwright-report-a11y/
/playwright-report-visual/
/playwright/.cache/
/test-results/
/test-results-visual/
# HIVE-10.1: the visual-parity harness's published report — screenshots, diffs and verdicts,
# regenerated on every run and uploaded by CI rather than committed.
/visual-parity-report/
/e2e/**/*.png
!/e2e/**/*.spec.ts-snapshots/*.png

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

visual-regression.spec.ts-snapshots/
